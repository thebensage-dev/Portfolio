# Copy to .env.local (gitignored) and fill in. Everything here is optional.
# The GitHub Packages token for @thebensage-dev/ui goes in .npmrc instead (see .npmrc.example).

# This site's own public URL (no trailing slash), for link previews, robots.txt and the sitemap.
# SITE_URL=https://example.com

# Public addresses of the linked projects, read at request time so the same Docker image
# works on any domain.
# User Directory (UserDirectory repo). Defaults to http://localhost:3000 (its `npm run dev`).
# USER_DIRECTORY_URL=https://users.example.com
# TheBensage API (Api repo), which the User Directory runs on, and the /api-reference page's OpenAPI document.
# Defaults to http://localhost:3002 (its `dotnet run`).
# API_URL=https://api.example.com
# Server-side address for the API's OpenAPI document, only needed when API_URL doesn't resolve
# from where this site runs, e.g. inside Docker.
# API_INTERNAL_URL=http://api:8080
# Storybook for @thebensage-dev/ui (SharedUI repo). Defaults to http://localhost:6006 (its `npm run dev`).
# STORYBOOK_URL=https://ui.example.com
# Public link of Grafana's "Live status" dashboard (Share > Share externally). Unset = no link.
# STATUS_URL=https://grafana.example.com/public-dashboards/<token>

# Sign-in through authentik (client "portfolio", created by Infrastructure's blueprint), which
# unlocks the colour palette for portfolio-members. All four set, or none (sign-in hidden).
# Uses SITE_URL above as this site's address (callback: SITE_URL/auth/callback).
# OIDC_ISSUER_URL=https://id.example.com/application/o/portfolio/
# OIDC_CLIENT_ID=portfolio
# OIDC_CLIENT_SECRET=
# Encrypts the session cookie: any long random string.
# AUTH_SECRET=
# Optional, for the local Docker stack: where the server reaches authentik (an origin).
# OIDC_INTERNAL_URL=http://authentik-server:9000

# The CMS (the Cms repo, Payload) that holds this site's pages, projects, header and footer: its address as this server
# reaches it. Defaults to http://localhost:3003 (its `npm run dev`). While it can't be reached
# the site keeps its last copy, or falls back on src/content/cms-snapshot.json
# (`npm run content:snapshot` refreshes that file from a running CMS).
# CMS_URL=https://cms.example.com
# Only when the browser reaches the CMS at another address than CMS_URL (as in the local Docker
# stack): the CMS's Live Preview may frame this site while previewing.
# CMS_PUBLIC_URL=http://cms.localhost:8080
# Optional: draft preview, the same value as the CMS's PREVIEW_SECRET. With it the CMS's Preview
# button opens a page here with its unpublished changes (src/app/preview/route.ts).
# PREVIEW_SECRET=
