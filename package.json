{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "docker:build": "node scripts/docker-build.mjs",
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:snapshot": "cms-snapshot --site portfolio --out src/content/cms-snapshot.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@payloadcms/live-preview-react": "3.94.2",
    "@scalar/api-reference-react": "0.9.95",
    "@thebensage-dev/auth": "^0.1.0",
    "@thebensage-dev/cms-client": "^0.2.0",
    "@thebensage-dev/ui": "^1.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "vue-demi": false
  }
}
